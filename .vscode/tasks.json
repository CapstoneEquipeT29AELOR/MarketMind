{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install MarketMind dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"--no-audit",
				"--no-fund"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build MarketMind",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$vite"
			]
		},
		{
			"label": "Run MarketMind",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"0.0.0.0"
			],
			"isBackground": true,
			"problemMatcher": [
				"$vite"
			]
		}
	]
}